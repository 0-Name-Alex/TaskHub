<Window x:Class="TaskHub.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskHub.App"
        Title="TaskHub launcher"
        Width="680" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        WindowStartupLocation="Manual"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <local:VisibleWhenConverter x:Key="Vis" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </Window.Resources>

  <Border x:Name="Root" Margin="18" CornerRadius="12" BorderThickness="1" Padding="10"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Direction="270" />
    </Border.Effect>
    <StackPanel>
      <Grid>
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.6" IsHitTestVisible="False" />
        <TextBox x:Name="QueryBox" FontSize="20" Padding="40,10,10,10" BorderThickness="0" Background="Transparent"
                 TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
        <TextBlock x:Name="Placeholder" Text="Search apps, tasks and commands — or type a task to add it"
                   FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="44,0,0,0" IsHitTestVisible="False" />
      </Grid>

      <ListBox x:Name="Results" MaxHeight="460" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
               HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="OnResultDoubleClick" PreviewKeyDown="OnQueryKeyDown" Focusable="False">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type local:LauncherRow}">
            <Grid Margin="2,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Subtitle, Converter={StaticResource Vis}}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" Margin="12,0,6,0"
                         Visibility="{Binding Hint, Converter={StaticResource Vis}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="Footer" FontSize="11" Opacity="0.5" Margin="8,6,8,0"
                 Text="↑↓ choose · Enter run · Ctrl+Enter complete task · Esc close" />
    </StackPanel>
  </Border>
</Window>
