<Window x:Class="TaskHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskHub.App"
        xmlns:vm="clr-namespace:TaskHub.App.ViewModels"
        Title="TaskHub"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Icon="pack://application:,,,/Assets/TaskHub.ico">
  <Window.Resources>
    <local:VisibleWhenConverter x:Key="Vis" />
    <local:ColorBrushConverter x:Key="ColorBrush" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Small uppercase section label used in the editor -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="0,6,0,8" />
    </Style>

    <!-- Placeholder text laid over an empty text box -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- App shell: compact icon rail on the left, page on the right -->
    <Style x:Key="ShellTabs" TargetType="TabControl">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource LayerFillColorAltBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                  <Image DockPanel.Dock="Top" Source="pack://application:,,,/Assets/TaskHub.ico" Width="26" Height="26"
                         Margin="0,18,0,22" HorizontalAlignment="Center"
                         ToolTip="TaskHub · Ctrl+Alt+Space launcher · Ctrl+Alt+N quick add" />
                  <StackPanel IsItemsHost="True" />
                </DockPanel>
              </Border>
              <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="0"
                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A rail entry: icon (Tag) over a small label (Header), with a selection pill -->
    <Style x:Key="NavTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Margin="8,2" Padding="0,9,0,8" CornerRadius="8" Background="Transparent">
              <Grid>
                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" Margin="-8,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock x:Name="Icon" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Opacity="0.85" />
                  <ContentPresenter x:Name="Label" ContentSource="Header" HorizontalAlignment="Center" Margin="0,5,0,0"
                                    TextElement.FontSize="11" Opacity="0.85" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter TargetName="Icon" Property="Opacity" Value="1" />
                <Setter TargetName="Label" Property="Opacity" Value="1" />
                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar (views/lists) entry: subtle fill + accent pill, same as the rail -->
    <Style x:Key="SideItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Margin="0,1" Padding="10,7" CornerRadius="6" Background="Transparent">
              <Grid>
                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Margin="-10,0,0,0" HorizontalAlignment="Left"
                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                <ContentPresenter x:Name="Content" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Task row container: hover fill, selection outline -->
    <Style x:Key="TaskItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Margin="0,1" CornerRadius="6" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Round "complete" button; its BorderBrush is the priority colour -->
    <Style x:Key="TaskCheck" TargetType="Button">
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="20" Height="20" Background="Transparent">
              <Ellipse x:Name="Fill" Fill="{TemplateBinding BorderBrush}" Opacity="0" />
              <Ellipse x:Name="Ring" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" />
              <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"
                         Foreground="{TemplateBinding BorderBrush}" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fill" Property="Opacity" Value="0.15" />
                <Setter TargetName="Mark" Property="Opacity" Value="0.9" />
              </Trigger>
              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCompleting}" Value="True">
                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
              </DataTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small flat icon button (row actions, editor close, list colour) -->
    <Style x:Key="RowAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" MinWidth="28" Height="28" CornerRadius="5" Background="Transparent" Padding="6,0">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small rounded count badge -->
    <Style x:Key="CountBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <TabControl x:Name="Tabs" Style="{StaticResource ShellTabs}" ItemContainerStyle="{StaticResource NavTab}" BorderThickness="0" Padding="0">
    <!-- ============================== TASKS ============================== -->
    <TabItem Header="Tasks" Tag="&#xE73A;">
      <Grid DataContext="{Binding Tasks}" Margin="12,12,20,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Margin="0,8,8,0">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,4,0">
            <Button Style="{StaticResource RowAction}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Command="{Binding StartNewListCommand}" ToolTip="Create a list. Right-click a list to change its colour or icon."
                    Visibility="{Binding IsAddingList, Converter={StaticResource Vis}, ConverterParameter=invert}">
              <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="New list" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Visibility="{Binding IsAddingList, Converter={StaticResource Vis}}">
              <Grid>
                <TextBox x:Name="NewListBox" Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}"
                         IsVisibleChanged="OnNewListBoxVisibleChanged" LostKeyboardFocus="OnNewListBoxLostFocus">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CreateListCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="List name" Margin="11,0,8,0" Style="{StaticResource Placeholder}"
                           Visibility="{Binding NewListName, Converter={StaticResource Vis}, ConverterParameter=invert}" />
              </Grid>
              <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" Text="Enter to create · Esc to cancel" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="NavList" ItemsSource="{Binding NavView}" SelectedItem="{Binding SelectedNav}"
                   BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemContainerStyle="{StaticResource SideItem}" PreviewMouseRightButtonUp="OnNavRightClick">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Opacity="0.6" Margin="8,12,0,4" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavItem}">
                <Grid Background="Transparent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Opacity="0.8" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="2" Style="{StaticResource CountBadge}" Margin="8,0,0,0"
                          Visibility="{Binding CountText, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" Opacity="0.85" />
                  </Border>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasColor}" Value="True">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Color, Converter={StaticResource ColorBrush}}" />
                    <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Centre: heading, quick add, task list -->
        <DockPanel Grid.Column="1" Margin="8,8,8,0">
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,4,0,16">
              <Grid DockPanel.Dock="Right" Width="240" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="32,6,8,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search (Ctrl+F, Esc to clear)" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="11,0,0,0"
                           Style="{StaticResource Placeholder}" />
                <TextBlock Text="Search" Margin="33,0,8,0" Style="{StaticResource Placeholder}"
                           Visibility="{Binding SearchText, Converter={StaticResource Vis}, ConverterParameter=invert}" />
              </Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ListColorButton" Style="{StaticResource RowAction}" Margin="-6,2,4,0" VerticalAlignment="Center"
                        ToolTip="List colour and icon" Click="OnListColorButtonClick"
                        Visibility="{Binding SelectedList, Converter={StaticResource Vis}}">
                  <TextBlock Text="{Binding SelectedList.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SelectedList.HasColor}" Value="True">
                            <Setter Property="Foreground" Value="{Binding SelectedList.Color, Converter={StaticResource ColorBrush}}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button>
                <TextBlock Text="{Binding Heading}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="16,5,0,0" VerticalAlignment="Center"
                            ToolTip="Completed today out of everything due today"
                            Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}">
                  <Grid Width="18" Height="18">
                    <Ellipse Width="17" Height="17" StrokeThickness="2" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Path Data="{Binding ProgressArc}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                  </Grid>
                  <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </DockPanel>

            <Grid>
              <TextBox x:Name="QuickAddBox" FontSize="15" Padding="40,10,12,10"
                       Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Natural language: Pay rent tomorrow 9am #home !high @Finance">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding QuickAddCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="14,0,0,0"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
              <TextBlock Text="Add a task" FontSize="15" Margin="41,0,12,0" Style="{StaticResource Placeholder}"
                         Visibility="{Binding QuickAddText, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            </Grid>
            <Grid Margin="4,6,0,10" MinHeight="22">
              <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                         Text="e.g.  Pay rent tomorrow 9am #home !high @Finance  ·  Ctrl+N"
                         Visibility="{Binding QuickAddText, Converter={StaticResource Vis}, ConverterParameter=invert}" />
              <DockPanel Visibility="{Binding QuickAddText, Converter={StaticResource Vis}}">
                <TextBlock DockPanel.Dock="Right" Text="Enter to add" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="8,3,4,0" />
                <ItemsControl ItemsSource="{Binding QuickAddChips}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PreviewChip}">
                      <Border CornerRadius="10" Padding="8,2,9,2" Margin="0,0,6,4" BorderThickness="1"
                              Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="ChipIcon" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                     VerticalAlignment="Center" Margin="0,0,5,0" Opacity="0.8" />
                          <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasColor}" Value="True">
                          <Setter TargetName="ChipIcon" Property="Foreground" Value="{Binding Color, Converter={StaticResource ColorBrush}}" />
                          <Setter TargetName="ChipIcon" Property="Opacity" Value="1" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Grid>
          </StackPanel>

          <Grid>
            <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                     BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TaskItem}">
              <ListBox.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="8,14,0,4">
                        <TextBlock x:Name="GroupName" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ItemCount}" FontSize="12" Opacity="0.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Name}" Value="Overdue">
                          <Setter TargetName="GroupName" Property="Foreground" Value="#E5484D" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListBox.GroupStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                  <Border x:Name="Row" Padding="8,6,6,6" Background="Transparent">
                    <Border.RenderTransform>
                      <TranslateTransform />
                    </Border.RenderTransform>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Button x:Name="Check" Style="{StaticResource TaskCheck}" VerticalAlignment="Top" Margin="0,1,10,0"
                              Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                              CommandParameter="{Binding}" ToolTip="Complete (Space)" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <WrapPanel Visibility="{Binding HasMeta, Converter={StaticResource Vis}}" Margin="0,1,0,0">
                          <TextBlock x:Name="DueText" Text="{Binding DueText}" Style="{StaticResource Caption}" Margin="0,0,12,0"
                                     Visibility="{Binding DueText, Converter={StaticResource Vis}}" />
                          <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding ListName, Converter={StaticResource Vis}}">
                            <Ellipse Width="7" Height="7" Margin="0,1,5,0" VerticalAlignment="Center"
                                     Fill="{Binding ListColor, Converter={StaticResource ColorBrush}}"
                                     Visibility="{Binding ListColor, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding ListName}" Style="{StaticResource Caption}" />
                          </StackPanel>
                          <TextBlock Text="{Binding TagsText}" Style="{StaticResource Caption}" Margin="0,0,12,0"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                     Visibility="{Binding TagsText, Converter={StaticResource Vis}}" />
                          <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" Style="{StaticResource Caption}" ToolTip="Has notes"
                                     Margin="0,0,8,0" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" />
                          <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" Style="{StaticResource Caption}"
                                     ToolTip="{Binding RecurrenceText}" Visibility="{Binding IsRecurring, Converter={StaticResource Vis}}" />
                        </WrapPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Next reminder chip -->
                        <Border x:Name="ReminderChip" CornerRadius="9" Padding="7,1,8,1" Margin="8,0,0,0"
                                VerticalAlignment="Center" BorderThickness="1" ToolTip="{Binding ReminderText}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Visibility="{Binding HasReminder, Converter={StaticResource Vis}}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ReminderIcon" Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.75" />
                            <TextBlock x:Name="ReminderTextBlock" Text="{Binding ReminderShort}" FontSize="12" VerticalAlignment="Center" Opacity="0.75" />
                          </StackPanel>
                        </Border>
                        <!-- Hover actions -->
                        <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="6,0,0,0" Visibility="Collapsed">
                          <Button x:Name="PostponeButton" Style="{StaticResource RowAction}" ToolTip="Move to tomorrow"
                                  Command="{Binding DataContext.PostponeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                          </Button>
                          <Button x:Name="DeleteButton" Style="{StaticResource RowAction}" ToolTip="Move to trash (Delete)"
                                  Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                          </Button>
                          <Button x:Name="RestoreButton" Style="{StaticResource RowAction}" ToolTip="Restore" Visibility="Collapsed"
                                  Command="{Binding DataContext.RestoreSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Priority}" Value="Medium">
                      <Setter TargetName="Check" Property="BorderBrush" Value="#3E8EF7" />
                      <Setter TargetName="Check" Property="ToolTip" Value="Complete (Space) · medium priority" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Priority}" Value="High">
                      <Setter TargetName="Check" Property="BorderBrush" Value="#F76B15" />
                      <Setter TargetName="Check" Property="ToolTip" Value="Complete (Space) · high priority" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                      <Setter TargetName="Check" Property="BorderBrush" Value="#E5484D" />
                      <Setter TargetName="Check" Property="ToolTip" Value="Complete (Space) · urgent" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ReminderSoon}" Value="True">
                      <Setter TargetName="ReminderChip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                      <Setter TargetName="ReminderIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      <Setter TargetName="ReminderIcon" Property="Opacity" Value="1" />
                      <Setter TargetName="ReminderTextBlock" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      <Setter TargetName="ReminderTextBlock" Property="Opacity" Value="1" />
                      <Setter TargetName="ReminderTextBlock" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                      <Setter TargetName="Check" Property="IsEnabled" Value="False" />
                      <Setter TargetName="PostponeButton" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="DeleteButton" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                      <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                      <Setter TargetName="TitleText" Property="Opacity" Value="0.55" />
                      <Setter TargetName="PostponeButton" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCompleting}" Value="True">
                      <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                      <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="CompleteFade">
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity"
                                             To="0" BeginTime="0:0:0.08" Duration="0:0:0.24" />
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                             To="24" BeginTime="0:0:0.08" Duration="0:0:0.24">
                              <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseIn" />
                              </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                      <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="CompleteFade" />
                      </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                      <Setter TargetName="DueText" Property="Foreground" Value="#E5484D" />
                      <Setter TargetName="DueText" Property="Opacity" Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                      <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      <Setter TargetName="DueText" Property="Opacity" Value="1" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0" IsHitTestVisible="False"
                        Visibility="{Binding EmptyText, Converter={StaticResource Vis}}">
              <TextBlock Text="&#xE73A;" FontFamily="{StaticResource IconFont}" FontSize="40" Opacity="0.25" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyText}" Opacity="0.6" FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
            </StackPanel>
          </Grid>
        </DockPanel>

        <!-- Right: editor (only while a task is selected) -->
        <Border Grid.Column="2" Width="360" Margin="8,4,0,0" Padding="20,14,14,16" CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource RowAction}" Command="{Binding CloseEditorCommand}"
                        ToolTip="Close (Esc) — unsaved changes are saved">
                  <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <TextBlock Text="TASK" Style="{StaticResource SectionLabel}" Margin="0,0,0,0" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="0,0,0,18" ToolTip="Title" />

              <TextBlock Text="SCHEDULE" Style="{StaticResource SectionLabel}" />

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Due date" Style="{StaticResource Caption}" />
                  <DatePicker SelectedDate="{Binding EditDueDate}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Time" Style="{StaticResource Caption}" />
                  <TextBox Text="{Binding EditDueTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" ToolTip="e.g. 09:30 or 6pm; empty = all day" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Priority" Style="{StaticResource Caption}" />
                  <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding EditPriority}" Margin="0,2,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="List" Style="{StaticResource Caption}" />
                  <ComboBox ItemsSource="{Binding ListOptions}" SelectedValuePath="Id"
                            SelectedValue="{Binding EditListId}" Margin="0,2,0,0" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:ListOption}">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center"
                                   Fill="{Binding Color, Converter={StaticResource ColorBrush}}"
                                   Visibility="{Binding Color, Converter={StaticResource Vis}}" />
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <TextBlock Text="Repeat" Style="{StaticResource Caption}" />
              <TextBox Text="{Binding EditRecurrence, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                       ToolTip="e.g. every monday · daily · weekdays · every 2 weeks · monthly — or an iCalendar RRULE" />
              <TextBlock Text="{Binding RecurrencePreview}" Margin="0,2,0,12" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding RecurrenceInvalid}" Value="True">
                        <Setter Property="Foreground" Value="#D13438" />
                        <Setter Property="Opacity" Value="1" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <Separator Margin="0,4,0,14" Opacity="0.5" />
              <TextBlock Text="REMINDERS" Style="{StaticResource SectionLabel}" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Remind me" Style="{StaticResource Caption}" />
                  <ComboBox ItemsSource="{Binding ReminderChoices}" SelectedItem="{Binding EditReminder}" DisplayMemberPath="Label"
                            Margin="0,2,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Until done, remind" Style="{StaticResource Caption}" />
                  <ComboBox ItemsSource="{Binding RepeatChoices}" SelectedItem="{Binding EditRepeatReminder}" DisplayMemberPath="Label"
                            Margin="0,2,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding NextReminderText}" Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                         Visibility="{Binding NextReminderText, Converter={StaticResource Vis}}" />

              <TextBlock Text="When reminded, also" Style="{StaticResource Caption}" />
              <TextBox Text="{Binding EditReminderActions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12" MinHeight="44" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" Margin="0,2,0,0"
                       ToolTip="One action per line: open &lt;url|file&gt; · notify &lt;title&gt; | &lt;body&gt; · copy &lt;text&gt; · run &lt;program&gt; &lt;args&gt; · add &lt;task&gt; · dnd on|off" />
              <TextBlock Text="{Binding ReminderActionsHint}" Margin="0,2,0,12" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ReminderActionsInvalid}" Value="True">
                        <Setter Property="Foreground" Value="#D13438" />
                        <Setter Property="Opacity" Value="1" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <Separator Margin="0,4,0,14" Opacity="0.5" />
              <TextBlock Text="DETAILS" Style="{StaticResource SectionLabel}" />
              <TextBlock Text="Tags" Style="{StaticResource Caption}" />
              <TextBox Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" ToolTip="Space or comma separated, e.g. #home #errands" />

              <TextBlock Text="Notes" Style="{StaticResource Caption}" />
              <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="120" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,2,0,12" />

              <StackPanel Visibility="{Binding Attachments.Count, Converter={StaticResource Vis}}" Margin="0,0,0,12">
                <TextBlock Text="Attachments" Style="{StaticResource Caption}" />
                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,2,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AttachmentRow}">
                      <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Padding="6,2" Margin="4,0,0,0" ToolTip="Remove from the task (the file stays)"
                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                          <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                        <Button DockPanel.Dock="Right" Padding="6,2" Margin="4,0,0,0" ToolTip="Show in folder"
                                Command="{Binding DataContext.ShowAttachmentInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                          <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                        <Button HorizontalContentAlignment="Left" Padding="8,3" ToolTip="{Binding Path}"
                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE723;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Separator Margin="0,4,0,14" Opacity="0.5" />
              <WrapPanel>
                <Button Content="Save" Command="{Binding SaveEditorCommand}" Margin="0,0,8,8" ToolTip="Ctrl+S" MinWidth="88"
                        IsEnabled="{Binding EditorDirty}" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Revert" Command="{Binding RevertEditorCommand}" Margin="0,0,8,8" IsEnabled="{Binding EditorDirty}" />
                <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,8" ToolTip="Delete key"
                        Visibility="{Binding SelectionIsDeleted, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                <Button Content="Restore" Command="{Binding RestoreSelectedCommand}" Margin="0,0,8,8"
                        Visibility="{Binding SelectionIsDeleted, Converter={StaticResource Vis}}" />
              </WrapPanel>
              <TextBlock Text="{Binding EditInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="4,8,0,0" LastChildFill="True">
          <Button DockPanel.Dock="Right" Command="{Binding UndoCommand}" ToolTip="{Binding UndoTooltip}"
                  Visibility="{Binding UndoDescription, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Undo" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button DockPanel.Dock="Right" Command="{Binding JumpToAddedCommand}" Margin="0,0,8,0"
                  Visibility="{Binding JumpTarget, Converter={StaticResource Vis}}"
                  Content="Show" Style="{DynamicResource AccentButtonStyle}" />
          <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.75" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="#D13438" />
                    <Setter Property="Opacity" Value="1" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </DockPanel>
      </Grid>
    </TabItem>

    <!-- ============================== NOTIFICATIONS ============================== -->
    <TabItem x:Name="NotificationsTab" Header="Notifications" Tag="&#xEA8F;">
      <Grid DataContext="{Binding Notifications}" Margin="28,24,28,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
          <DockPanel>
            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding DoNotDisturb}" VerticalAlignment="Center">
              <TextBlock Text="Do Not Disturb" FontSize="15" FontWeight="SemiBold" />
            </CheckBox>
            <TextBlock Text="{Binding DndStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="{Binding SettingsSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,12,0,12">
          <TextBlock Text="Try it:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
          <Button Content="Normal" Command="{Binding TestNotificationCommand}" CommandParameter="normal" Margin="0,0,8,4" />
          <Button Content="High priority" Command="{Binding TestNotificationCommand}" CommandParameter="high" Margin="0,0,8,4" />
          <Button Content="Urgent" Command="{Binding TestNotificationCommand}" CommandParameter="urgent" Margin="0,0,8,4" />
          <Button Content="With reply box" Command="{Binding TestNotificationCommand}" CommandParameter="reply" Margin="0,0,8,4" />
          <Button Content="Camera in use" Command="{Binding TestIndicatorCommand}" CommandParameter="camera" Margin="0,0,8,4" />
          <Button Content="Mic in use" Command="{Binding TestIndicatorCommand}" CommandParameter="mic" Margin="0,0,24,4" />
          <Button Content="Clear history" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,4" />
        </WrapPanel>

        <Grid Grid.Row="2">
          <ListBox ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HistoryRow}">
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Icon" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0" Opacity="0.8" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="40"
                               Visibility="{Binding Body, Converter={StaticResource Vis}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               Visibility="{Binding Outcome, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               Visibility="{Binding Status, Converter={StaticResource Vis}}" />
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Missed}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="#F09A1A" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ============================== AUTOMATION ============================== -->
    <TabItem x:Name="AutomationTab" Header="Automation" Tag="&#xE945;">
      <Grid DataContext="{Binding Automation}" Margin="28,24,28,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Rules -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Edit rules" Command="{Binding OpenConfigCommand}" VerticalAlignment="Top" />
            <StackPanel>
              <TextBlock Text="Rules" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,12,0" />
            </StackPanel>
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding ConfigErrors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#D13438" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding Message, Converter={StaticResource Vis}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Opacity" Value="0.8" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                      <Setter Property="Foreground" Value="#D13438" />
                      <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <ListBox Grid.Row="2" ItemsSource="{Binding Rules}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                   Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RuleRow}">
                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="When " /><Run Text="{Binding Trigger, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                      </TextBlock>
                      <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding Condition, Converter={StaticResource Vis}}">
                        <Run Text="If " /><Run Text="{Binding Condition, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" />
                      </TextBlock>
                      <TextBlock Text="{Binding Actions}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.9" />
                      <TextBlock x:Name="StateText" Text="{Binding State}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.7" />
                      <TextBlock x:Name="LastRunText" Text="{Binding LastRun}" FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                                 Visibility="{Binding LastRun, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0" ToolTip="Run the actions now (ignores 'when' and 'if')"
                            Command="{Binding DataContext.RunRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" IsEnabled="{Binding Ok}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Run now" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Ok}" Value="False">
                    <Setter TargetName="StateText" Property="Foreground" Value="#D13438" />
                    <Setter TargetName="StateText" Property="Opacity" Value="1" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding LastOk}" Value="False">
                    <Setter TargetName="LastRunText" Property="Foreground" Value="#D13438" />
                    <Setter TargetName="LastRunText" Property="Opacity" Value="1" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Watches, system, activity -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Watched folders" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="None. Add [[watch]] entries to the config file; new files there trigger file.detected."
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding Watches.Count, Converter={StaticResource Vis}, ConverterParameter=invert}" />
            <ItemsControl ItemsSource="{Binding Watches}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:WatchRow}">
                  <StackPanel Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                      <TextBlock x:Name="WatchState" Text="{Binding State}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" />
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Ok}" Value="False">
                      <Setter TargetName="WatchState" Property="Foreground" Value="#D13438" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="This computer" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SystemText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>

          <DockPanel Grid.Row="2" Margin="0,16,0,6">
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearActivityCommand}" />
            <StackPanel>
              <TextBlock Text="Recent runs" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Rules and tasks' reminder actions." Style="{StaticResource Caption}" />
            </StackPanel>
          </DockPanel>
          <ListBox Grid.Row="3" ItemsSource="{Binding Activity}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ActivityRow}">
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="OkIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,2,0,0" Foreground="#2E9E44" />
                  <StackPanel Grid.Column="1">
                    <TextBlock TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Rule, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Time, Mode=OneWay}" FontSize="11" />
                      <Run Text="{Binding Trigger, Mode=OneWay}" FontSize="11" />
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Ok}" Value="False">
                    <Setter TargetName="OkIcon" Property="Text" Value="&#xE783;" />
                    <Setter TargetName="OkIcon" Property="Foreground" Value="#D13438" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ============================== DIAGNOSTICS ============================== -->
    <TabItem Header="Diagnostics" Tag="&#xE9D9;">
      <Grid DataContext="{Binding Diagnostics}" Margin="28,24,28,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="340" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="Global hotkeys" />
            <ItemsControl ItemsSource="{Binding Hotkeys}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HotkeyRow}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding State}" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Ok}" Value="False">
                                <Setter Property="Foreground" Value="#D13438" />
                                <Setter Property="Opacity" Value="1" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,2" CornerRadius="4" VerticalAlignment="Top"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                      <TextBlock Text="{Binding Gesture}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Muted}" FontSize="11"
                       Text="Change hotkeys in the config file; they re-register as soon as you save it." />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
            <CheckBox Content="Start TaskHub when I sign in to Windows" IsChecked="{Binding AutostartEnabled}" />
            <TextBlock Text="{Binding AutostartError}" Foreground="#D13438" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Files" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding ConfigPath}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding DataPath}" Margin="0,2,0,8" />
            <WrapPanel>
              <Button Content="Edit config" Command="{Binding OpenConfigCommand}" Margin="0,0,8,8" />
              <Button Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
              <Button Content="Data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearEventsCommand}" />
            <StackPanel>
              <TextBlock Text="Live events" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="Everything published on the event bus." />
            </StackPanel>
          </DockPanel>
          <ListView Grid.Row="1" ItemsSource="{Binding Events}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding Time}" />
                <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding Type}" />
                <GridViewColumn Header="Source" Width="90" DisplayMemberBinding="{Binding Source}" />
                <GridViewColumn Header="Data" Width="400" DisplayMemberBinding="{Binding Data}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
