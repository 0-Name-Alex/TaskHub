<Project Sdk="Microsoft.NET.Sdk">
  <!-- `th` — command-line client for the running TaskHub app (talks to the local API). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>th</AssemblyName>
    <RootNamespace>TaskHub.Cli</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaskHub.Abstractions\TaskHub.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaskHub.Api.Tests" />
  </ItemGroup>
</Project>
